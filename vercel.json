{
  "version": 2,
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build:web",
  "outputDirectory": "public",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/auth/(.*)",       "destination": "https://linkpulse-api-0w93.onrender.com/auth/$1" },
    { "source": "/workspaces/(.*)", "destination": "https://linkpulse-api-0w93.onrender.com/workspaces/$1" },
    { "source": "/health/(.*)",     "destination": "https://linkpulse-api-0w93.onrender.com/health/$1" },
    { "source": "/:alias([a-zA-Z0-9_-]{3,64})", "destination": "https://linkpulse-api-0w93.onrender.com/:alias" }
  ]
}
