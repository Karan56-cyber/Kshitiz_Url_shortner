{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:web",
  "outputDirectory": "public",
  "routes": [
    {
      "src": "/(.*)",
      "dest": "${RENDER_API_ORIGIN}/$1",
      "env": ["RENDER_API_ORIGIN"]
    }
  ]
}
