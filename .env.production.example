# Copy to a private .env file for local production runs, or add these values to
# Render's Environment settings. Replace every placeholder; never commit secrets.
NODE_ENV=production
HOST=0.0.0.0
PORT=10000
DEMO_MODE=false
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=require
# In Upstash, copy the Redis TCP connection string (rediss://) from Connect.
# Replace special characters in the password with URL-encoded equivalents.
REDIS_URL=rediss://default:UPSTASH_REDIS_PASSWORD@UPSTASH_REDIS_HOST:6379
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PUBLIC_BASE_URL=https://short.remindkro.in
CLICK_EVENT_RETENTION_DAYS=90
EMBEDDED_WORKER=true

# Optional: set all SMTP values to enable password-reset emails.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=LinkPulse <no-reply@example.com>
