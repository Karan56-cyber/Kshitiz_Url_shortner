# Production environment template. Replace every placeholder in the hosting
# provider's secret settings; never commit live credentials.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DEMO_MODE=false
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
REDIS_URL=rediss://default:PASSWORD@redis.example.com:6379
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PUBLIC_BASE_URL=https://your-app.example.com
CLICK_EVENT_RETENTION_DAYS=90
EMBEDDED_WORKER=true
