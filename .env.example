NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DEMO_MODE=false
DATABASE_URL=postgresql://linkpulse:linkpulse@localhost:5432/linkpulse?schema=public
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
REDIS_URL=redis://localhost:6379
